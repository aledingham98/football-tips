# --- Secrets (NEVER commit) ---
.env
.env.*
!.env.example
.streamlit/secrets.toml
secrets.toml
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version.local

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.hypothesis/

# --- Notebooks ---
.ipynb_checkpoints/
notebooks/**/output/

# --- OS ---
.DS_Store
Thumbs.db

# --- Data: commit processed/model outputs, ignore heavy raw caches ---
# Raw ingestion caches - rebuilt by the nightly Action, not committed (keeps the
# repo lean). The FBref (soccerdata) cache is the rate-limit shield and lives in
# the GitHub Actions cache + local dev machines.
data/raw/fbref_cache/
data/raw/football_data_couk/
data/raw/football_data_org/
data/raw/**/*.html
data/raw/**/*.json.gz

# Backtest artifacts - reproducible via scripts/run_backtest.py
data/processed/calibration_*.parquet
soccerdata/

# Keep these tracked (the deployed app reads them at runtime):
!data/processed/matches.parquet
!data/model/
!data/raw/odds/
