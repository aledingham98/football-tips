# Copy to .streamlit/secrets.toml for local dev (that file is gitignored).
# On Streamlit Community Cloud, paste the same keys into
#   App -> Settings -> Secrets
# On GitHub, add them as repository secrets for the Actions workflows.

[football_data_org]
api_key = "REPLACE_ME"        # free key from football-data.org (10 req/min)

[the_odds_api]
api_key = "REPLACE_ME"        # free Starter tier, 500 credits/month
quota_floor = 50              # hard-stop when x-requests-remaining drops below this

[betfair]
username = "REPLACE_ME"
password = "REPLACE_ME"
app_key = "REPLACE_ME"        # FREE Delayed application key (createDeveloperAppKeys)

[supabase]
url = "REPLACE_ME"
anon_key = "REPLACE_ME"
